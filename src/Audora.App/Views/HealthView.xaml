<UserControl x:Class="Audora.App.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- One page chip: Scan, Sound Check -->
    <DataTemplate x:Key="PageChipTemplate">
      <Button Content="{Binding Label}" Style="{StaticResource PresetChip}"
              Command="{Binding DataContext.ChoosePageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding}"/>
    </DataTemplate>

    <!-- One device to test -->
    <DataTemplate x:Key="DeviceChoiceTemplate">
      <Button Content="{Binding Label}" Style="{StaticResource PresetChip}"
              Command="{Binding DataContext.ChooseDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding}"/>
    </DataTemplate>

    <!-- One answer in the list -->
    <DataTemplate x:Key="ResultTemplate">
      <TextBlock Text="{Binding}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6"/>
    </DataTemplate>

    <!-- One line of the scan result -->
    <DataTemplate x:Key="FindingTemplate">
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="86"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="{Binding LevelText}" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding LevelText}" Value="OK">
                  <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LevelText}" Value="WARNING">
                  <Setter Property="Foreground" Value="#E8A317"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LevelText}" Value="PROBLEM">
                  <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Detail}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"
                     Foreground="{DynamicResource MutedBrush}"
                     Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="{Binding Area}" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}"/>
          <Button Content="{Binding RepairLabel}" Style="{StaticResource AudoraButton}"
                  HorizontalAlignment="Left" Margin="0,8,0,0" MinWidth="90"
                  Command="{Binding DataContext.AskRepairCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                  CommandParameter="{Binding}"
                  Visibility="{Binding CanRepair, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="Health" FontSize="22" FontWeight="SemiBold"/>

      <ItemsControl ItemsSource="{Binding Pages}" ItemTemplate="{StaticResource PageChipTemplate}" Margin="0,10,0,6">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <!-- Scan -->
      <StackPanel Visibility="{Binding IsScanPage, Converter={StaticResource BoolToVis}}">
        <TextBlock Margin="0,0,0,14" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                   Text="Checks Windows audio services, outputs, microphones, drivers and key settings. The scan is read-only and works while Audora is off."/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
          <Button Content="{Binding ButtonText}" Command="{Binding ScanCommand}"
                  Style="{StaticResource AudoraButton}" MinWidth="120" HorizontalAlignment="Left"/>
          <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="13"
                     Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="{Binding PendingTitle}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding PendingText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource MutedBrush}"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="Unmute" Command="{Binding ConfirmRepairCommand}" Style="{StaticResource AudoraButton}"
                      MinWidth="90" Margin="0,0,8,0"/>
              <Button Content="Cancel" Command="{Binding CancelRepairCommand}" Style="{StaticResource AudoraButton}"
                      MinWidth="90"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14"
                    Visibility="{Binding HasRepairMessage, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="{Binding RepairMessage}" FontSize="13" TextWrapping="Wrap" MaxWidth="600" VerticalAlignment="Center"/>
          <Button Content="Undo" Command="{Binding UndoRepairCommand}" Style="{StaticResource AudoraButton}"
                  MinWidth="80" Margin="12,0,0,0"
                  Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
          <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingTemplate}"/>
        </Border>

        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,24"
                   Text="A scan finds software and configuration problems. It cannot detect damaged speakers, cables or ports. Fixes always ask for your approval first."/>
      </StackPanel>

      <!-- Sound Check -->
      <StackPanel Visibility="{Binding IsSoundCheckPage, Converter={StaticResource BoolToVis}}">
        <StackPanel DataContext="{Binding SoundCheck}">
          <TextBlock Margin="0,0,0,14" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                     Text="Play a short, quiet test tone and listen. Tones are generated locally, fade in, and stop on their own; Stop ends one immediately. Audora never changes your volume."/>

          <TextBlock Text="Output device" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceChoiceTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <TextBlock Text="{Binding VolumeText}" FontSize="12.5" Margin="0,2,0,6">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding VolumeWarning}" Value="True">
                    <Setter Property="Foreground" Value="#E8A317"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
            <Button Content="Left side" Command="{Binding PlayCommand}" CommandParameter="left"
                    Style="{StaticResource AudoraButton}" MinWidth="96" Margin="0,0,8,0"/>
            <Button Content="Right side" Command="{Binding PlayCommand}" CommandParameter="right"
                    Style="{StaticResource AudoraButton}" MinWidth="96" Margin="0,0,8,0"/>
            <Button Content="Both sides" Command="{Binding PlayCommand}" CommandParameter="both"
                    Style="{StaticResource AudoraButton}" MinWidth="96" Margin="0,0,8,0"/>
            <Button Content="Sweep" Command="{Binding PlayCommand}" CommandParameter="sweep"
                    Style="{StaticResource AudoraButton}" MinWidth="96" Margin="0,0,24,0"/>
            <Button Content="Stop" Command="{Binding StopCommand}"
                    Style="{StaticResource AudoraButton}" MinWidth="80"/>
          </StackPanel>

          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,8"/>
          <Button Content="Play anyway" Command="{Binding PlayAnywayCommand}"
                  Style="{StaticResource AudoraButton}" HorizontalAlignment="Left" Margin="0,0,0,12"
                  Visibility="{Binding CanPlayAnyway, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="{Binding EngineNote}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                     Foreground="{DynamicResource MutedBrush}"
                     Visibility="{Binding ShowEngineNote, Converter={StaticResource BoolToVis}}"/>
          <Button Content="Turn Audora off for this test" Command="{Binding TurnEngineOffCommand}"
                  Style="{StaticResource AudoraButton}" HorizontalAlignment="Left" Margin="0,0,0,12"
                  Visibility="{Binding ShowEngineNote, Converter={StaticResource BoolToVis}}"/>

          <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                  Visibility="{Binding HasQuestion, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <TextBlock Text="{Binding Question}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Yes" Command="{Binding YesCommand}" Style="{StaticResource AudoraButton}"
                        MinWidth="80" Margin="0,0,8,0"/>
                <Button Content="No" Command="{Binding NoCommand}" Style="{StaticResource AudoraButton}" MinWidth="80"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                  Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <TextBlock Text="Results this session" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <ItemsControl ItemsSource="{Binding Results}" ItemTemplate="{StaticResource ResultTemplate}"/>
            </StackPanel>
          </Border>

          <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,24"
                     Text="Results reflect what you heard. They cannot prove a speaker is healthy or damaged. Nothing is saved to disk."/>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
