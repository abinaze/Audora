<UserControl x:Class="Audora.App.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- One line of the scan result -->
    <DataTemplate x:Key="FindingTemplate">
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="86"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="{Binding LevelText}" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding LevelText}" Value="OK">
                  <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LevelText}" Value="WARNING">
                  <Setter Property="Foreground" Value="#E8A317"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LevelText}" Value="PROBLEM">
                  <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Detail}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"
                     Foreground="{DynamicResource MutedBrush}"
                     Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="{Binding Area}" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="Health" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Margin="0,6,0,14" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                 Text="A scan looks at your Windows audio services, sound outputs, microphones and drivers. It only reads: it changes nothing, and it works even when Audora is off."/>

      <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
        <Button Content="{Binding ButtonText}" Command="{Binding ScanCommand}"
                Style="{StaticResource AudoraButton}" MinWidth="120" HorizontalAlignment="Left"/>
        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="13"
                   Foreground="{DynamicResource MutedBrush}"/>
      </StackPanel>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14"
              Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
        <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingTemplate}"/>
      </Border>

      <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,24"
                 Text="A scan can find software problems. It cannot tell whether a speaker, cable or port is physically damaged. Fixing problems comes later and will always ask you first."/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
