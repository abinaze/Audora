<UserControl x:Class="Audora.App.Views.MicrophoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- One microphone to pick -->
    <DataTemplate x:Key="MicrophoneChoiceTemplate">
      <Button Content="{Binding Label}" Style="{StaticResource PresetChip}"
              Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding}"/>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="Microphone" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Margin="0,6,0,14" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                 Text="Try noise removal on a microphone. Nothing listens until you press Test, a test stops by itself after 15 seconds, and the sound is only measured. It is never saved, played or sent."/>

      <TextBlock Text="Microphone" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <ItemsControl ItemsSource="{Binding Microphones}" ItemTemplate="{StaticResource MicrophoneChoiceTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <TextBlock Text="No microphone is connected." Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"
                 Visibility="{Binding HasNoMicrophones, Converter={StaticResource BoolToVis}}"/>
      <TextBlock Text="{Binding SelectedText}" FontSize="12" Margin="0,8,0,14" Foreground="{DynamicResource MutedBrush}"/>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="Noise removal" FontWeight="SemiBold"/>
              <TextBlock Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                         Text="Removes steady background noise such as fans and hum from your voice. It is off until you switch it on. It treats music as noise, so use it for talking."/>
            </StackPanel>
            <ToggleButton Grid.Column="1" Style="{StaticResource AudoraSwitch}" VerticalAlignment="Center"
                          IsChecked="{Binding NoiseRemoval, Mode=TwoWay}" IsEnabled="{Binding HasSelection}"
                          AutomationProperties.Name="Noise removal"/>
          </Grid>
          <Grid Margin="0,10,0,0" Visibility="{Binding NoiseRemoval, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="80"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Strength" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
            <Slider Grid.Column="1" Style="{StaticResource AudoraSlider}" Minimum="0" Maximum="100"
                    Value="{Binding NoiseStrength, Mode=TwoWay}" AutomationProperties.Name="Noise removal strength"/>
            <TextBlock Grid.Column="2" Text="{Binding NoiseStrength, StringFormat={}{0:0}%}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
          </Grid>
          <StackPanel Margin="0,10,0,0" Visibility="{Binding NoiseRemoval, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanChangeEngine}">
              <TextBlock Text="Engine" Width="80" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
              <Button Content="Studio" Style="{StaticResource PresetChip}"
                      Command="{Binding ChooseEngineCommand}" CommandParameter="Studio"
                      ToolTip="DeepFilterNet3. Cleanest in our tests. Uses more of the processor."/>
              <Button Content="Standard" Style="{StaticResource PresetChip}"
                      Command="{Binding ChooseEngineCommand}" CommandParameter="Standard"
                      ToolTip="RNNoise. Light on the processor."/>
            </StackPanel>
            <TextBlock Margin="80,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                       Text="{Binding EngineText}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="{Binding TestButtonText}" Command="{Binding TestCommand}"
                    Style="{StaticResource AudoraButton}" MinWidth="150" HorizontalAlignment="Left"/>
          </StackPanel>
          <TextBlock Text="{Binding Status}" Margin="0,12,0,14" FontSize="13" TextWrapping="Wrap"/>

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Before cleaning" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
            <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Height="10" BorderThickness="0"
                         Value="{Binding InputBar, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"
                         Background="{DynamicResource SurfaceAltBrush}" AutomationProperties.Name="Level before cleaning"/>
            <TextBlock Grid.Column="2" Text="{Binding InputText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="After cleaning" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
            <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Height="10" BorderThickness="0"
                         Value="{Binding OutputBar, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"
                         Background="{DynamicResource SurfaceAltBrush}" AutomationProperties.Name="Level after cleaning"/>
            <TextBlock Grid.Column="2" Text="{Binding OutputText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,24"
                 Text="This page is a test. Sending the cleaned voice to other apps needs a virtual cable that you install yourself, and is not built yet. If the microphone shows only silence, it may be muted in Windows or blocked in Settings, Privacy and security, Microphone. Audora does not change those."/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
