<UserControl x:Class="Audora.App.Views.SoundView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- One equalizer band -->
    <DataTemplate x:Key="BandTemplate">
      <StackPanel Width="56" HorizontalAlignment="Center">
        <TextBlock Text="{Binding GainText}" FontSize="12" HorizontalAlignment="Center"
                   Foreground="{DynamicResource MutedBrush}"/>
        <Slider Style="{StaticResource VerticalSlider}" Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                TickFrequency="0.5" IsSnapToTickEnabled="True" Height="200" Margin="0,8" HorizontalAlignment="Center"
                Value="{Binding Gain, Mode=TwoWay}" AutomationProperties.Name="{Binding Label}"/>
        <TextBlock Text="{Binding Label}" FontSize="12" HorizontalAlignment="Center"/>
      </StackPanel>
    </DataTemplate>

    <!-- One profile or preset -->
    <DataTemplate x:Key="PresetTemplate">
      <Button Content="{Binding Name}" Style="{StaticResource PresetChip}" ToolTip="{Binding Preset.Description}"
              Command="{Binding DataContext.ChoosePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding}"/>
    </DataTemplate>

    <!-- One "edit sound for" choice -->
    <DataTemplate x:Key="TargetTemplate">
      <Button Content="{Binding Label}" Style="{StaticResource PresetChip}"
              Command="{Binding DataContext.ChooseTargetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding}"/>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock Text="Sound" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Margin="0,6,0,14" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                 Text="Pick a profile for what you are doing, or let Smart choose. Sound changes apply to the devices Audora plays on. Your Windows default device plays directly, so it cannot be processed (turn on Full control in Settings to change that)."/>

      <TextBlock Text="Edit sound for" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
      <ItemsControl ItemsSource="{Binding Targets}" ItemTemplate="{StaticResource TargetTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <TextBlock Text="{Binding ScopeNote}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,14"
                 Foreground="{DynamicResource MutedBrush}"/>

      <TextBlock Text="Profiles" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
      <ItemsControl ItemsSource="{Binding Presets}" ItemTemplate="{StaticResource PresetTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,14" Foreground="{DynamicResource MutedBrush}">
        <Run Text="Now using: "/><Run Text="{Binding Summary, Mode=OneWay}" FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextBrush}"/><Run Text="  -  "/><Run Text="{Binding ActiveDescription, Mode=OneWay}"/>
      </TextBlock>

      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="280"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox Style="{StaticResource SearchBox}" Tag="Name this sound, then press Save"
                 Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Preset name"/>
        <Button Grid.Column="1" Content="Save as my preset" Style="{StaticResource AudoraButton}" Margin="10,0,0,0"
                Command="{Binding SavePresetCommand}"/>
        <Button Grid.Column="2" Content="Delete this preset" Style="{StaticResource AudoraButton}" Margin="8,0,0,0"
                Command="{Binding DeletePresetCommand}"
                Visibility="{Binding CanDeletePreset, Converter={StaticResource BoolToVis}}"/>
      </Grid>

      <!-- Effects -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,18">
        <StackPanel>
          <TextBlock Text="{Binding TargetTitle}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
          <TextBlock Text="Effects" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,14"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="170"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Bass" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" Style="{StaticResource AudoraSlider}" Minimum="-10" Maximum="10" TickFrequency="0.5"
                    IsSnapToTickEnabled="True" Margin="14,0" Value="{Binding Bass, Mode=TwoWay}" AutomationProperties.Name="Bass"/>
            <TextBlock Grid.Column="2" Text="{Binding BassText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>
          </Grid>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="170"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Treble" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" Style="{StaticResource AudoraSlider}" Minimum="-10" Maximum="10" TickFrequency="0.5"
                    IsSnapToTickEnabled="True" Margin="14,0" Value="{Binding Treble, Mode=TwoWay}" AutomationProperties.Name="Treble"/>
            <TextBlock Grid.Column="2" Text="{Binding TrebleText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>
          </Grid>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="170"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Voice clarity"/>
              <TextBlock Text="Clearer speech and dialogue" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
            <Slider Grid.Column="1" Style="{StaticResource AudoraSlider}" Minimum="0" Maximum="100" Margin="14,0"
                    Value="{Binding VoiceClarity, Mode=TwoWay}" AutomationProperties.Name="Voice clarity"/>
            <TextBlock Grid.Column="2" Text="{Binding VoiceText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>
          </Grid>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="170"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Volume stabilizer"/>
              <TextBlock Text="Evens out loud and quiet parts" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
            <Slider Grid.Column="1" Style="{StaticResource AudoraSlider}" Minimum="0" Maximum="100" Margin="14,0"
                    Value="{Binding Stabilizer, Mode=TwoWay}" AutomationProperties.Name="Volume stabilizer"/>
            <TextBlock Grid.Column="2" Text="{Binding StabilizerText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>
          </Grid>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="170"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Surround (3D)"/>
              <TextBlock Text="Wider, more spread out, best on headphones" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
            <Slider Grid.Column="1" Style="{StaticResource AudoraSlider}" Minimum="0" Maximum="100" Margin="14,0"
                    Value="{Binding Virtualizer, Mode=TwoWay}" AutomationProperties.Name="Surround"/>
            <TextBlock Grid.Column="2" Text="{Binding VirtualizerText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>
          </Grid>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="170"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Stereo width" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" Style="{StaticResource AudoraSlider}" Minimum="0" Maximum="200" Margin="14,0"
                    Value="{Binding Width, Mode=TwoWay}" AutomationProperties.Name="Stereo width"/>
            <TextBlock Grid.Column="2" Text="{Binding WidthText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <Button Content="Back to Original" Style="{StaticResource AudoraButton}" Command="{Binding ResetCommand}"/>
            <Button Content="Use the All devices sound" Style="{StaticResource AudoraButton}" Margin="8,0,0,0"
                    Command="{Binding FollowAllCommand}"
                    Visibility="{Binding ShowFollowAll, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Advanced equalizer -->
      <ToggleButton Style="{StaticResource ToggleChip}" HorizontalAlignment="Left" Margin="0,0,0,12"
                    Content="Advanced equalizer" IsChecked="{Binding ShowAdvanced, Mode=TwoWay}"/>

      <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,18"
              Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVis}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Width="72" Margin="0,0,10,0">
            <TextBlock Text="{Binding PreampText}" FontSize="12" HorizontalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>
            <Slider Style="{StaticResource VerticalSlider}" Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                    TickFrequency="0.5" IsSnapToTickEnabled="True" Height="200" Margin="0,8" HorizontalAlignment="Center"
                    Value="{Binding Preamp, Mode=TwoWay}" AutomationProperties.Name="Preamp"/>
            <TextBlock Text="Preamp" FontSize="12" HorizontalAlignment="Center"/>
          </StackPanel>

          <StackPanel Grid.Column="1">
            <ItemsControl ItemsSource="{Binding Bands}" ItemTemplate="{StaticResource BandTemplate}" HorizontalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="Frequency in Hz. Drag a band up to boost it or down to cut it (range plus or minus 12 dB)."
                       FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}"/>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
