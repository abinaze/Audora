<Window x:Class="Audora.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audora" Width="1120" Height="780" MinWidth="940" MinHeight="640"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- One device -->
    <DataTemplate x:Key="DeviceCard">
      <Border Width="452" Margin="0,0,16,16" Style="{StaticResource Card}" Padding="20,18">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource SurfaceAltBrush}">
              <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="21"
                         Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Name}"/>
              <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding TypeText, Mode=OneWay}"/><Run Text="  -  "/><Run Text="{Binding StateText, Mode=OneWay}"/>
              </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
              <ToggleButton Style="{StaticResource AudoraSwitch}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            IsEnabled="{Binding CanSelect}" AutomationProperties.Name="Play on this device"/>
              <TextBlock Text="{Binding SwitchLabel}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"
                         Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
          </Grid>

          <TextBlock Text="{Binding DetailText}" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource DangerBrush}"
                     Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>

          <Grid Margin="0,16,0,0" Visibility="{Binding ShowMirrorControls, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="92"/>
            </Grid.ColumnDefinitions>
            <ToggleButton Content="Mute" Style="{StaticResource ToggleChip}" IsChecked="{Binding IsMuted, Mode=TwoWay}"/>
            <Slider Grid.Column="1" Style="{StaticResource AudoraSlider}" Margin="14,0" Minimum="0" Maximum="200"
                    Value="{Binding Volume, Mode=TwoWay}" AutomationProperties.Name="Volume"/>
            <TextBlock Grid.Column="2" Text="{Binding VolumeText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>
          </Grid>

          <TextBlock Margin="0,16,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                     Visibility="{Binding ShowDefaultNote, Converter={StaticResource BoolToVis}}"
                     Text="{Binding DefaultNote}"/>

          <Grid Margin="0,14,0,0" Visibility="{Binding ShowMirrorControls, Converter={StaticResource BoolToVis}}">
            <Button Content="Fine tune" HorizontalAlignment="Left" Style="{StaticResource AudoraButton}"
                    Padding="12,6" FontSize="12" Command="{Binding ToggleDetailsCommand}"/>
            <Button Content="Make Windows default" HorizontalAlignment="Right" Style="{StaticResource AudoraButton}"
                    Padding="12,6" FontSize="12" Command="{Binding MakeDefaultCommand}"/>
          </Grid>

          <StackPanel Margin="0,14,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="Balance" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
              <Slider Grid.Column="1" Style="{StaticResource AudoraSlider}" Minimum="-100" Maximum="100"
                      Value="{Binding Balance, Mode=TwoWay}" AutomationProperties.Name="Left and right balance"/>
              <TextBlock Grid.Column="2" Text="{Binding Balance, StringFormat={}{0:+0;-0;0}}" HorizontalAlignment="Right"
                         VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
              <TextBlock Grid.Row="1" Text="Delay" Margin="0,10,0,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource MutedBrush}"/>
              <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource AudoraSlider}" Minimum="0" Maximum="2000"
                      Margin="0,10,0,0" Value="{Binding Delay, Mode=TwoWay}" AutomationProperties.Name="Audio delay"/>
              <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Delay, StringFormat={}{0:0} ms}" Margin="0,10,0,0"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
            </Grid>
            <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                       Text="Delay lines this device up with a slower one. Bluetooth is usually the slowest. Give it no delay and add delay to the others. Sound (equalizer) for this device is on the Sound tab."/>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- One group -->
    <DataTemplate x:Key="GroupCard">
      <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="20,18">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" FontSize="16" FontWeight="SemiBold"
                       Background="Transparent" BorderThickness="0" Padding="0" Foreground="{DynamicResource TextBrush}"
                       CaretBrush="{DynamicResource TextBrush}" SelectionBrush="{DynamicResource AccentBrush}"
                       ToolTip="Click the name to rename" AutomationProperties.Name="Group name"/>
              <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}">
                <Run Text="{Binding Summary, Mode=OneWay}"/><Run Text="{Binding ActiveText, Mode=OneWay}"/>
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Play group" Style="{StaticResource AudoraButton}" Command="{Binding PlayCommand}"
                      Visibility="{Binding IsInactive, Converter={StaticResource BoolToVis}}"/>
              <Button Content="Stop group" Style="{StaticResource AudoraButton}" Command="{Binding StopCommand}"
                      Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
              <Button Content="Delete" Style="{StaticResource AudoraButton}" Margin="8,0,0,0" Command="{Binding DeleteCommand}"/>
            </StackPanel>
          </Grid>

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <ToggleButton Content="Mute" Style="{StaticResource ToggleChip}" IsChecked="{Binding IsMuted, Mode=TwoWay}"/>
            <Slider Grid.Column="1" Style="{StaticResource AudoraSlider}" Minimum="0" Maximum="200" Margin="14,0"
                    Value="{Binding Volume, Mode=TwoWay}" AutomationProperties.Name="Group volume"/>
            <TextBlock Grid.Column="2" Text="{Binding VolumeText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>
          </Grid>
          <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                     Text="Group volume changes the devices Audora plays on. The Windows default device follows the master volume."/>

          <ItemsControl ItemsSource="{Binding Members}" Margin="0,16,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                  </StackPanel>
                  <Slider Grid.Column="1" Style="{StaticResource AudoraSlider}" Minimum="0" Maximum="200" Margin="12,0"
                          Value="{Binding Device.Volume, Mode=TwoWay}" AutomationProperties.Name="Device volume"
                          Visibility="{Binding Device.ShowMirrorControls, Converter={StaticResource BoolToVis}}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Device.VolumeText}" HorizontalAlignment="Right"
                             VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                             Visibility="{Binding Device.ShowMirrorControls, Converter={StaticResource BoolToVis}}"/>
                  <Button Grid.Column="3" Content="Remove" Style="{StaticResource AudoraButton}" Padding="10,4" FontSize="12"
                          Margin="12,0,0,0" Command="{Binding RemoveCommand}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
              <TextBlock Text="{Binding BluetoothHint}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                         Foreground="{DynamicResource MutedBrush}"
                         Visibility="{Binding HasBluetoothHint, Converter={StaticResource BoolToVis}}"/>

              <StackPanel Margin="0,8,0,16" Visibility="{Binding HasKnownDevices, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Saved devices (not connected now)" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,10" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                           Text="Audora remembers devices you used before, with their volume and sound. Connect one in Windows and it comes back by itself."/>
                <ItemsControl ItemsSource="{Binding KnownDevices}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,12">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}">
                              <Run Text="{Binding TypeText, Mode=OneWay}"/><Run Text="  -  "/><Run Text="{Binding LastSeenText, Mode=OneWay}"/>
                            </TextBlock>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Open Bluetooth settings" Style="{StaticResource AudoraButton}" Padding="10,5" FontSize="12"
                                    Command="{Binding OpenBluetoothCommand}"
                                    Visibility="{Binding IsBluetooth, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Forget" Style="{StaticResource AudoraButton}" Padding="10,5" FontSize="12"
                                    Margin="8,0,0,0" Command="{Binding ForgetCommand}"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

          <Button Content="Use the devices that are playing now" Style="{StaticResource AudoraButton}"
                  HorizontalAlignment="Left" Padding="12,6" FontSize="12" Margin="0,4,0,0"
                  Command="{Binding UseCurrentCommand}"/>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- One equalizer band -->
    <DataTemplate x:Key="BandTemplate">
      <StackPanel Width="56" HorizontalAlignment="Center">
        <TextBlock Text="{Binding GainText}" FontSize="12" HorizontalAlignment="Center"
                   Foreground="{DynamicResource MutedBrush}"/>
        <Slider Style="{StaticResource VerticalSlider}" Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                TickFrequency="0.5" IsSnapToTickEnabled="True" Height="220" Margin="0,8" HorizontalAlignment="Center"
                Value="{Binding Gain, Mode=TwoWay}" AutomationProperties.Name="{Binding Label}"/>
        <TextBlock Text="{Binding Label}" FontSize="12" HorizontalAlignment="Center"/>
      </StackPanel>
    </DataTemplate>

    <!-- One reverb type -->
    <DataTemplate x:Key="RoomTemplate">
      <Button Content="{Binding Name}" Style="{StaticResource PresetChip}"
              Command="{Binding DataContext.ChooseRoomCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding}"/>
    </DataTemplate>

    <!-- One preset chip -->
    <DataTemplate x:Key="PresetTemplate">
      <Button Content="{Binding Name}" Style="{StaticResource PresetChip}"
              Command="{Binding DataContext.ChoosePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding}"/>
    </DataTemplate>

    <!-- One "edit sound for" chip -->
    <DataTemplate x:Key="TargetTemplate">
      <Button Content="{Binding Label}" Style="{StaticResource PresetChip}"
              Command="{Binding DataContext.ChooseTargetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding}"/>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="88"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Navigation rail -->
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="0,24,0,16">
        <Viewbox DockPanel.Dock="Top" Width="40" Height="34" Margin="0,0,0,28">
          <Canvas Width="746" Height="642">
            <Path Data="{StaticResource MarkDark}" Fill="#351B9F"/>
            <Path Data="{StaticResource MarkBlue}" Fill="#1676FC"/>
            <Path Data="{StaticResource MarkPurple}" Fill="#7E33F5"/>
          </Canvas>
        </Viewbox>
        <StackPanel DockPanel.Dock="Top">
          <RadioButton Content="Devices" GroupName="nav" Style="{StaticResource NavButton}"
                       IsChecked="{Binding IsDevicesTab, Mode=TwoWay}">
            <RadioButton.Tag>
              <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            </RadioButton.Tag>
          </RadioButton>
          <RadioButton Content="Groups" GroupName="nav" Style="{StaticResource NavButton}"
                       IsChecked="{Binding IsGroupsTab, Mode=TwoWay}">
            <RadioButton.Tag>
              <Path Data="M4 4H10V10H4Z M14 4H20V10H14Z M4 14H10V20H4Z M14 14H20V20H14Z" StrokeThickness="2" Width="24" Height="24"
                    Stretch="None" StrokeLineJoin="Round"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            </RadioButton.Tag>
          </RadioButton>
          <RadioButton Content="Sound" GroupName="nav" Style="{StaticResource NavButton}"
                       IsChecked="{Binding IsSoundTab, Mode=TwoWay}">
            <RadioButton.Tag>
              <Path Data="M6 4V20M12 4V20M18 4V20M3 14H9M9 8H15M15 16H21" StrokeThickness="2" Width="24" Height="24"
                    Stretch="None" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            </RadioButton.Tag>
          </RadioButton>
          <RadioButton Content="Settings" GroupName="nav" Style="{StaticResource NavButton}"
                       IsChecked="{Binding IsSettingsTab, Mode=TwoWay}">
            <RadioButton.Tag>
              <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            </RadioButton.Tag>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Main area -->
    <Grid Grid.Column="1" Margin="28,22,28,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header -->
      <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
        <Viewbox DockPanel.Dock="Left" Height="14" VerticalAlignment="Center">
          <Path Data="{StaticResource Wordmark}" Fill="{DynamicResource TextBrush}"/>
        </Viewbox>
        <TextBlock DockPanel.Dock="Right" Text="{Binding RoutingText}" FontSize="12" VerticalAlignment="Center"
                   Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
      </DockPanel>

      <!-- Master volume (the Windows volume bar, and every other device) -->
      <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="64"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <ToggleButton Content="Mute" Style="{StaticResource ToggleChip}" VerticalAlignment="Center"
                          IsChecked="{Binding IsMasterMuted, Mode=TwoWay}"/>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Master volume" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="Windows volume bar, and all your other devices" FontSize="12"
                         Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
          </StackPanel>
          <Slider Grid.Column="1" Style="{StaticResource AudoraSlider}" Margin="26,0"
                  Value="{Binding Master, Mode=TwoWay}" AutomationProperties.Name="Master volume"/>
          <TextBlock Grid.Column="2" Text="{Binding MasterText}" FontSize="16" FontWeight="SemiBold"
                     HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- Pages -->
      <Grid Grid.Row="2">

        <!-- Devices -->
        <Grid Visibility="{Binding IsDevicesTab, Converter={StaticResource BoolToVis}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Text="Turn on the devices you want to play on. Your Windows default device is always on."
                     Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,0,0,12"/>

          <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource SearchBox}" Tag="Search devices"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search devices"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
              <Button Content="Play on all" Style="{StaticResource AudoraButton}" Command="{Binding SelectAllCommand}"/>
              <Button Content="Stop all" Style="{StaticResource AudoraButton}" Margin="8,0,0,0" Command="{Binding DeselectAllCommand}"/>
              <Button Content="Mute all" Style="{StaticResource AudoraButton}" Margin="8,0,0,0" Command="{Binding MuteAllCommand}"/>
              <Button Content="Unmute all" Style="{StaticResource AudoraButton}" Margin="8,0,0,0" Command="{Binding UnmuteAllCommand}"/>
              <Button Content="Refresh" Style="{StaticResource AudoraButton}" Margin="8,0,0,0" Command="{Binding RefreshCommand}"/>
            </StackPanel>
          </Grid>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="No audio devices found yet. Connect a speaker or headphones and it appears here."
                         Foreground="{DynamicResource MutedBrush}" Margin="0,24,0,0"
                         Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVis}}"/>
              <ItemsControl ItemsSource="{Binding View}" ItemTemplate="{StaticResource DeviceCard}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- Groups -->
        <Grid Visibility="{Binding IsGroupsTab, Converter={StaticResource BoolToVis}}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="Groups" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Margin="0,6,0,14" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                         Text="Save the devices you play on together as a group, such as Living room or Headphones only. Play a group in one click and control its volume on its own. Turn the devices on in the Devices tab first, then save them here."/>

              <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Style="{StaticResource SearchBox}" Tag="Group name, for example Living room"
                           Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}"
                           AutomationProperties.Name="Group name"/>
                  <Button Grid.Column="1" Content="Save playing devices as a group" Style="{StaticResource AudoraButton}"
                          Margin="12,0,0,0" Command="{Binding CreateGroupCommand}"/>
                </Grid>
              </Border>

              <TextBlock Text="{Binding GroupMessage}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"
                         Foreground="{DynamicResource MutedBrush}"/>
              <TextBlock Text="No groups yet." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"
                         Visibility="{Binding HasNoGroups, Converter={StaticResource BoolToVis}}"/>

              <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupCard}"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- Sound -->
        <Grid Visibility="{Binding IsSoundTab, Converter={StaticResource BoolToVis}}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel DataContext="{Binding Sound}">
              <TextBlock Text="Sound" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Margin="0,6,0,14" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                         Text="Shape the sound of the devices Audora plays on. Your Windows default device plays directly, so it cannot be processed (turn on Full control in Settings to change that). Original means no changes."/>

              <TextBlock Text="Edit sound for" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
              <ItemsControl ItemsSource="{Binding Targets}" ItemTemplate="{StaticResource TargetTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <TextBlock Text="{Binding ScopeNote}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,14"
                         Foreground="{DynamicResource MutedBrush}"/>

              <TextBlock Text="Presets" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
              <ItemsControl ItemsSource="{Binding Presets}" ItemTemplate="{StaticResource PresetTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="280"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource SearchBox}" Tag="Name this sound, then press Save"
                         Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Preset name"/>
                <Button Grid.Column="1" Content="Save as my preset" Style="{StaticResource AudoraButton}" Margin="10,0,0,0"
                        Command="{Binding SavePresetCommand}"/>
                <Button Grid.Column="2" Content="Delete this preset" Style="{StaticResource AudoraButton}" Margin="8,0,0,0"
                        Command="{Binding DeletePresetCommand}"
                        Visibility="{Binding CanDeletePreset, Converter={StaticResource BoolToVis}}"/>
              </Grid>

              <Border Style="{StaticResource Card}" Margin="0,8,0,16" Padding="22,18">
                <StackPanel>
                  <TextBlock Text="Effects" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Margin="0,4,0,14" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                             Text="3D makes the sound wider and more spread out, best on headphones. It is a simple widening effect, not true surround sound. Reverb adds the echo of a room, hall or stage."/>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="150"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="3D virtualizer" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Style="{StaticResource AudoraSlider}" Minimum="0" Maximum="100" Margin="14,0"
                            Value="{Binding Virtualizer, Mode=TwoWay}" AutomationProperties.Name="3D virtualizer"/>
                    <TextBlock Grid.Column="2" Text="{Binding VirtualizerText}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                  </Grid>

                  <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="150"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Reverb" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Style="{StaticResource AudoraSlider}" Minimum="0" Maximum="100" Margin="14,0"
                            Value="{Binding ReverbAmount, Mode=TwoWay}" AutomationProperties.Name="Reverb amount"/>
                    <TextBlock Grid.Column="2" Text="{Binding ReverbText}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                  </Grid>

                  <TextBlock Text="Reverb type" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,8"/>
                  <ItemsControl ItemsSource="{Binding Rooms}" ItemTemplate="{StaticResource RoomTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}" Margin="0,8,0,16" Padding="22,18">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <!-- Preamp -->
                  <StackPanel Grid.Column="0" Width="72" Margin="0,0,10,0">
                    <TextBlock Text="{Binding PreampText}" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <Slider Style="{StaticResource VerticalSlider}" Minimum="-12" Maximum="12" SmallChange="0.5"
                            LargeChange="2" TickFrequency="0.5" IsSnapToTickEnabled="True" Height="220" Margin="0,8"
                            HorizontalAlignment="Center" Value="{Binding Preamp, Mode=TwoWay}"
                            AutomationProperties.Name="Preamp"/>
                    <TextBlock Text="Preamp" FontSize="12" HorizontalAlignment="Center"/>
                  </StackPanel>

                  <!-- Bands -->
                  <StackPanel Grid.Column="1">
                    <ItemsControl ItemsSource="{Binding Bands}" ItemTemplate="{StaticResource BandTemplate}"
                                  HorizontalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="Frequency in Hz. Drag a band up to boost it or down to cut it (range plus or minus 12 dB)."
                               FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"
                               Foreground="{DynamicResource MutedBrush}"/>
                  </StackPanel>

                  <!-- Tone -->
                  <StackPanel Grid.Column="2" Width="250" Margin="18,0,0,0">
                    <TextBlock Text="{Binding TargetTitle}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{Binding Summary}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,14"/>

                    <Grid>
                      <TextBlock Text="Bass" Foreground="{DynamicResource MutedBrush}"/>
                      <TextBlock Text="{Binding BassText}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
                    </Grid>
                    <Slider Style="{StaticResource AudoraSlider}" Minimum="-10" Maximum="10" TickFrequency="0.5"
                            IsSnapToTickEnabled="True" Margin="0,4,0,14" Value="{Binding Bass, Mode=TwoWay}"
                            AutomationProperties.Name="Bass"/>

                    <Grid>
                      <TextBlock Text="Treble" Foreground="{DynamicResource MutedBrush}"/>
                      <TextBlock Text="{Binding TrebleText}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
                    </Grid>
                    <Slider Style="{StaticResource AudoraSlider}" Minimum="-10" Maximum="10" TickFrequency="0.5"
                            IsSnapToTickEnabled="True" Margin="0,4,0,14" Value="{Binding Treble, Mode=TwoWay}"
                            AutomationProperties.Name="Treble"/>

                    <Grid>
                      <TextBlock Text="Stereo width" Foreground="{DynamicResource MutedBrush}"/>
                      <TextBlock Text="{Binding WidthText}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
                    </Grid>
                    <Slider Style="{StaticResource AudoraSlider}" Minimum="0" Maximum="200" Margin="0,4,0,18"
                            Value="{Binding Width, Mode=TwoWay}" AutomationProperties.Name="Stereo width"/>

                    <Button Content="Back to Original" Style="{StaticResource AudoraButton}" Command="{Binding ResetCommand}"/>
                    <Button Content="Use the All devices sound" Style="{StaticResource AudoraButton}" Margin="0,8,0,0"
                            Command="{Binding FollowAllCommand}"
                            Visibility="{Binding ShowFollowAll, Converter={StaticResource BoolToVis}}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- Settings -->
        <Grid Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVis}}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
              <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>

              <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold"/>
                  <Button Content="{Binding ThemeButtonText}" Command="{Binding ToggleThemeCommand}"
                          Style="{StaticResource AudoraButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Full control" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                             Text="Windows plays your default device directly, so Audora cannot change its sound. With a free virtual audio cable, Audora plays every device itself: the equalizer, boost, balance and delay then work on all of them, and you can line up Bluetooth with the rest."/>
                  <TextBlock Text="{Binding FullControlStatus}" Margin="0,10,0,0" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Get the free virtual cable" Style="{StaticResource AudoraButton}" Margin="0,0,8,0"
                            Command="{Binding GetCableCommand}"
                            Visibility="{Binding CableMissing, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Turn on full control" Style="{StaticResource AudoraButton}" Margin="0,0,8,0"
                            Command="{Binding TurnOnFullControlCommand}"
                            Visibility="{Binding CanTurnOnFullControl, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Turn off full control" Style="{StaticResource AudoraButton}"
                            Command="{Binding TurnOffFullControlCommand}"
                            Visibility="{Binding FullControlOn, Converter={StaticResource BoolToVis}}"/>
                  </StackPanel>
                  <TextBlock Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                             Visibility="{Binding CableMissing, Converter={StaticResource BoolToVis}}"
                             Text="The virtual cable (VB-CABLE by VB-Audio) is separate software with its own license, so check its terms. Audora does not include it. Installing it needs administrator rights and a restart."/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="About" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}">
                    <Run Text="Audora "/><Run Text="{Binding AppVersion, Mode=OneWay}"/><Run Text=". Free for personal and noncommercial use. No account, no telemetry, nothing leaves your computer."/>
                  </TextBlock>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

      <!-- Status -->
      <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,10,0,0" FontSize="12"
                 Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
    </Grid>
  </Grid>
</Window>
