<Window x:Class="Audora.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audora" Width="980" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <DataTemplate x:Key="DeviceCard">
      <Border Margin="0,0,0,10">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                <Setter Property="Opacity" Value="0.6"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>

        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Border Background="{DynamicResource ChipBrush}" CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding TypeText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                </Border>
                <TextBlock Text="{Binding StateText}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Set as default" Style="{StaticResource AudoraButton}" Padding="10,5" FontSize="12"
                      Margin="0,0,14,0" Command="{Binding MakeDefaultCommand}"
                      Visibility="{Binding CanMakeDefault, Converter={StaticResource BoolToVis}}"
                      ToolTip="Make this the Windows default output"/>
              <ToggleButton Style="{StaticResource AudoraSwitch}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            IsEnabled="{Binding CanSelect}" ToolTip="Play on this device"
                            AutomationProperties.Name="Play on this device"/>
            </StackPanel>
          </Grid>

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="50"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ToggleButton Grid.Column="0" Content="Mute" Style="{StaticResource ToggleChip}"
                          IsChecked="{Binding IsMuted, Mode=TwoWay}" IsEnabled="{Binding IsAvailable}"/>
            <Slider Grid.Column="1" Style="{StaticResource AudoraSlider}" Margin="14,0"
                    Value="{Binding Volume, Mode=TwoWay}" IsEnabled="{Binding IsAvailable}"
                    AutomationProperties.Name="Volume"/>
            <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:0}%}" VerticalAlignment="Center"
                       HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
            <Button Grid.Column="3" Content="Details" Style="{StaticResource AudoraButton}" Padding="12,6"
                    Margin="14,0,0,0" FontSize="12" Command="{Binding ToggleDetailsCommand}"/>
          </Grid>

          <StackPanel Margin="0,14,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
            <Grid IsEnabled="{Binding CanAdjustMirror}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="Balance" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
              <Slider Grid.Row="0" Grid.Column="1" Style="{StaticResource AudoraSlider}" Minimum="-100" Maximum="100"
                      Value="{Binding Balance, Mode=TwoWay}" AutomationProperties.Name="Left and right balance"/>
              <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Balance, StringFormat={}{0:+0;-0;0}}"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
              <TextBlock Grid.Row="1" Text="Delay" Margin="0,10,0,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource MutedBrush}"/>
              <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource AudoraSlider}" Minimum="0" Maximum="2000"
                      Margin="0,10,0,0" Value="{Binding Delay, Mode=TwoWay}" AutomationProperties.Name="Audio delay"/>
              <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Delay, StringFormat={}{0:0} ms}" Margin="0,10,0,0"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
            </Grid>
            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                       Visibility="{Binding ShowDefaultNote, Converter={StaticResource BoolToVis}}"
                       Text="This is the Windows default device, so it plays directly. Balance and delay are not available for it. To line up a slow device such as Bluetooth, make the slow one the default and delay the others."/>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="28,22,28,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Grid.Row="0" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <Viewbox Width="38" Height="33">
          <Canvas Width="746" Height="642">
            <Path Data="{StaticResource MarkDark}" Fill="#351B9F"/>
            <Path Data="{StaticResource MarkBlue}" Fill="#1676FC"/>
            <Path Data="{StaticResource MarkPurple}" Fill="#7E33F5"/>
          </Canvas>
        </Viewbox>
        <Viewbox Height="14" Margin="16,0,0,0" VerticalAlignment="Center">
          <Path Data="{StaticResource Wordmark}" Fill="{DynamicResource TextBrush}"/>
        </Viewbox>
      </StackPanel>
      <Button DockPanel.Dock="Right" Content="{Binding ThemeButtonText}" Style="{StaticResource AudoraButton}"
              Command="{Binding ToggleThemeCommand}"/>
      <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource AudoraButton}" Margin="0,0,10,0"
              Command="{Binding RefreshCommand}"/>
    </DockPanel>

    <!-- Master control -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,14">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="50"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Master volume" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Slider Grid.Column="1" Style="{StaticResource AudoraSlider}" Margin="18,0"
                  Value="{Binding Master, Mode=TwoWay}" AutomationProperties.Name="Master volume"/>
          <TextBlock Grid.Column="2" Text="{Binding Master, StringFormat={}{0:0}%}" HorizontalAlignment="Right"
                     VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
        </Grid>
        <TextBlock Text="{Binding RoutingText}" Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
      </StackPanel>
    </Border>

    <!-- Toolbar -->
    <Grid Grid.Row="2" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox Style="{StaticResource SearchBox}" Tag="Search devices"
               Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search devices"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
        <Button Content="Select all" Style="{StaticResource AudoraButton}" Command="{Binding SelectAllCommand}"/>
        <Button Content="Deselect all" Style="{StaticResource AudoraButton}" Margin="8,0,0,0" Command="{Binding DeselectAllCommand}"/>
        <Button Content="Mute all" Style="{StaticResource AudoraButton}" Margin="8,0,0,0" Command="{Binding MuteAllCommand}"/>
        <Button Content="Unmute all" Style="{StaticResource AudoraButton}" Margin="8,0,0,0" Command="{Binding UnmuteAllCommand}"/>
        <CheckBox Content="Show disconnected" Margin="16,0,0,0" VerticalAlignment="Center"
                  Foreground="{DynamicResource MutedBrush}" IsChecked="{Binding ShowAll, Mode=TwoWay}"/>
      </StackPanel>
    </Grid>

    <!-- Devices -->
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding View}" ItemTemplate="{StaticResource DeviceCard}" Margin="0,0,6,0"/>
    </ScrollViewer>

    <!-- Status -->
    <TextBlock Grid.Row="4" Text="{Binding Status}" Margin="0,10,0,0" FontSize="12"
               Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
  </Grid>
</Window>
